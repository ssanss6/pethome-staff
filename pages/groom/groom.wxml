<view class="page">
  <view class="head">洗护工作台 · {{orders.length}} 单</view>

  <view class="order" wx:for="{{orders}}" wx:key="id">
    <view class="top">
      <text class="no">{{item.orderNo}}</text>
      <text class="st st-{{item.status}}">{{item.statusText}}</text>
    </view>
    <view class="meta">{{item.serviceDate}} {{item.slot}}</view>
    <view class="foot">
      <view class="btn" wx:if="{{item.status === 'BOOKED'}}" bindtap="onSignIn" data-id="{{item.id}}">到店签到</view>
      <view class="btn primary" wx:if="{{item.status === 'IN_SERVICE'}}" bindtap="onComplete" data-id="{{item.id}}">完成核销</view>
    </view>
  </view>

  <view class="empty" wx:if="{{orders.length === 0}}">暂无洗护订单</view>
</view>
