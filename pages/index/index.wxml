<view class="page">
  <!-- 顶部标题 -->
  <view class="app-head">
    <text class="title">今日任务</text>
    <text class="date">{{today}}</text>
    <text class="user" bindtap="onTapUser">{{loggedIn ? nickname : '未登录 ›'}}</text>
  </view>

  <block wx:if="{{loggedIn}}">
    <!-- 筛选标签 -->
    <scroll-view scroll-x class="filter-tabs">
      <view class="tab {{activeType === item.key ? 'on' : ''}}"
            wx:for="{{tabs}}" wx:key="key"
            bindtap="onTapTab" data-key="{{item.key}}">
        {{item.label}} {{item.count}}
      </view>
    </scroll-view>

    <!-- 任务列表 -->
    <view class="task-list">
      <view class="task-card {{item.status === 'DONE' ? 'done' : ''}}" wx:for="{{filteredTasks}}" wx:key="id">
        <view class="task-top">
          <view class="ph"><van-icon name="smile-o" size="40rpx" color="#BDB6AC" /></view>
          <view class="task-main">
            <view class="n">{{item.petName}}<text class="em">{{item.cageNo}} · {{item.roomTypeName}}</text></view>
            <view class="meta">
              <text class="p0">{{item.taskTypeDesc}}</text>
              <text>{{item.statusDesc}}</text>
            </view>
          </view>
        </view>
        <view class="task-foot" wx:if="{{item.status === 'PENDING'}}">
          <view class="btn-sm" bindtap="onDone" data-id="{{item.id}}">打卡完成</view>
        </view>
        <view class="task-foot" wx:else>
          <image wx:if="{{item.photoUrl}}" class="photo" src="{{item.photoUrl}}" mode="aspectFill" />
          <text class="done-tag">✓ 已完成</text>
        </view>
      </view>
      <view class="empty" wx:if="{{filteredTasks.length === 0}}">今日暂无照护任务</view>
    </view>
  </block>

  <block wx:else>
    <view class="empty-page">
      <view class="empty-text">登录后查看今日任务</view>
      <button class="login-btn" bindtap="onTapUser">账号登录</button>
    </view>
  </block>
</view>
